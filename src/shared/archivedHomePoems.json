[
  {
    "id": "tang-371275bc1f77",
    "title": "桃花谿",
    "author": "张旭",
    "dynasty": "唐",
    "lines": [
      "隐隐飞桥隔野烟，石矶西畔问渔船。",
      "桃花尽日随流水，洞在清谿何处边。"
    ]
  },
  {
    "id": "song-72466972fa4a",
    "title": "青玉案·一年春事都来几",
    "author": "无名氏",
    "dynasty": "宋",
    "lines": [
      "一年春事都来几。",
      "早过了、三之二。",
      "绿暗红嫣浑可事。",
      "绿杨庭院，暖风帘幕，有个人憔悴。",
      "买花载酒长安市。",
      "又争似家山见桃李。",
      "不枉东风吹客泪，相思难表，梦魂无据，惟有归来是。"
    ],
    "excerpt": [
      "一年春事都来几。",
      "早过了、三之二。",
      "绿暗红嫣浑可事。"
    ]
  },
  {
    "id": "song-6519e0029c81",
    "title": "浣溪沙·一曲新词酒一杯",
    "author": "晏殊",
    "dynasty": "宋",
    "lines": [
      "一曲新词酒一杯。",
      "去年天气旧亭台。",
      "夕阳西下几时回。",
      "无可奈何花落去，似曾相识燕归来。",
      "小园香径独徘徊。"
    ],
    "excerpt": [
      "一曲新词酒一杯。",
      "去年天气旧亭台。",
      "夕阳西下几时回。"
    ]
  },
  {
    "id": "song-80693822ff4d",
    "title": "清平乐·金风细细",
    "author": "晏殊",
    "dynasty": "宋",
    "lines": [
      "金风细细。",
      "叶叶梧桐坠。",
      "绿酒初尝人易醉。",
      "一枕小窗浓睡。",
      "紫微朱槿花残。",
      "斜阳却照阑干。",
      "双燕欲归时节，银屏昨夜微寒。"
    ],
    "excerpt": [
      "金风细细。",
      "叶叶梧桐坠。",
      "绿酒初尝人易醉。"
    ]
  },
  {
    "id": "tang-6439d114f7fc",
    "title": "哥舒歌",
    "author": "西鄙人",
    "dynasty": "唐",
    "lines": [
      "北斗七星高，哥舒夜带刀。",
      "至今窥牧马，不敢过临洮。"
    ]
  },
  {
    "id": "tang-347476971105",
    "title": "渡汉江",
    "author": "李频",
    "dynasty": "唐",
    "lines": [
      "岭外音书绝，经年复历春。",
      "近乡情更怯，不敢问来人。"
    ]
  },
  {
    "id": "song-153b82070c8f",
    "title": "浣溪沙·漠漠轻寒上小楼",
    "author": "秦观",
    "dynasty": "宋",
    "lines": [
      "漠漠轻寒上小楼。",
      "晓阴无赖似穷秋。",
      "淡烟流水画屏幽。",
      "自在飞花轻似梦，无边丝雨细如愁。",
      "宝帘闲挂小银钩。"
    ],
    "excerpt": [
      "淡烟流水画屏幽。",
      "自在飞花轻似梦，无边丝雨细如愁。",
      "宝帘闲挂小银钩。"
    ]
  }
]
